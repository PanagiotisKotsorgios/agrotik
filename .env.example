# AGROTIK — environment variables (works out-of-the-box με demo defaults)
#
# For LOCAL DEV:
#   Copy to .env.local, run `npx supabase start`, replace κλειδιά με αυτά που τυπώνει.
#
# For COOLIFY / PRODUCTION:
#   Set these στο Coolify UI. All services (Postgres, Auth, REST, Realtime, Kong,
#   the app) τρέχουν στον ίδιο host — δεν χρειάζεσαι εξωτερικές υπηρεσίες.

# ─── Secrets (ΑΛΛΑΞΕ ΓΙΑ PRODUCTION) ───────────────────────────────────
# Postgres superuser password. Any strong string.
POSTGRES_PASSWORD=postgres

# Long random string (≥ 32 chars). Signs όλα τα Supabase JWTs.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# JWT expiry in seconds (1h default)
JWT_EXP=3600

# ─── Supabase keys (JWTs signed με το JWT_SECRET) ──────────────────────
# Defaults είναι τα ΔΗΜΟΣΙΑ demo κλειδιά που αντιστοιχούν στο default JWT_SECRET.
# Για production, παράγε νέα με το script στο https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── URLs ──────────────────────────────────────────────────────────────
# What the BROWSER sees. Σε Coolify με domain, γίνεται π.χ. https://api.agrotik.gr
# Για internal (dev, μία μηχανή), κράτα default. Δουλεύει επειδή docker network resolves 'kong'.
NEXT_PUBLIC_SUPABASE_URL=http://kong:8000

# What emails link back to.
APP_ORIGIN=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000

# ─── Admin bootstrap ───────────────────────────────────────────────────
# Ο πρώτος που εγγράφεται με αυτό το email γίνεται αυτόματα admin.
SEED_ADMIN_EMAIL=admin@agrotik.gr
