# AGROTIK — environment variables
# Copy to .env.local for dev, or set these in Coolify for production.

# --- Supabase ---
# For local dev: http://127.0.0.1:54321 and the keys printed by `npx supabase start`.
# For production: your hosted Supabase project (self-hosted or supabase.com).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin bootstrap ---
# The first user to sign up with this email is granted `role='admin'` automatically.
SEED_ADMIN_EMAIL=admin@agrotik.gr
