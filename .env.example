# AGROTIK — environment variables
#
# Single-domain setup:
#   Browser hits agrotik.gr/api/...  →  Next.js rewrites → Kong (internal)
#   Δεν χρειάζεσαι subdomain, δεν χρειάζεσαι εξωτερική Supabase.
#
# For LOCAL DEV:
#   Copy to .env.local, run `npx supabase start`, replace κλειδιά με αυτά που τυπώνει.
#
# For COOLIFY / PRODUCTION:
#   Set στο Coolify UI. Ένα μόνο domain — π.χ. agrotik.gr.

# ─── Secrets (ΑΛΛΑΞΕ ΓΙΑ PRODUCTION) ───────────────────────────────────
POSTGRES_PASSWORD=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# ─── Supabase keys (JWTs signed με το JWT_SECRET) ──────────────────────
# Defaults = δημόσια demo keys. Παράγε νέα για prod.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── URLs ──────────────────────────────────────────────────────────────
# Public URL για τον browser. Ίδιο domain με την εφαρμογή (path /api).
# Local dev:      http://localhost:3000/api
# Prod:           https://agrotik.gr/api
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000/api

# Internal URL που χρησιμοποιεί ο server (Next.js proxy target).
# Local dev:      http://127.0.0.1:54321  (τι τυπώνει το `supabase start`)
# Docker compose: http://kong:8000
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321

# What emails link back to.
APP_ORIGIN=http://localhost:3000

# ─── Admin bootstrap ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@agrotik.gr

# ─── Migrations at container boot (compose only) ────────────────────────
# Postgres connection string για το auto-migration entrypoint.
SUPABASE_DB_URL=postgres://postgres:postgres@db:5432/postgres
