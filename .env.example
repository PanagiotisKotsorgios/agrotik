# AGROTIK — environment variables
# Copy to .env.local for dev, or set these in Coolify for production.

# --- Supabase (client-facing) ---
# Use your production Supabase URL + keys (self-hosted or hosted).
# For local dev: http://127.0.0.1:54321 and the keys `npx supabase start` prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres direct URL (only needed for automatic migrations at container boot) ---
# Format: postgresql://user:password@host:5432/postgres
# Leave empty to skip auto-migrations (apply manually).
SUPABASE_DB_URL=

# --- Admin bootstrap ---
# The first user who signs up with this email is granted role='admin' automatically.
SEED_ADMIN_EMAIL=admin@agrotik.gr

# --- Public app URL (used inside emails, deep links, etc.) ---
APP_ORIGIN=http://localhost:3000
